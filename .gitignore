# Rust build output
/target/
**/target/
# Dedicated Cargo target directory used for local Android deployment builds.
# Keep this explicit: its name does not match the standard `target/` rule and
# it can grow to several gigabytes.
/target-mobile-deploy/
/target-android-deploy/
# Cargo target directory for the statically linked musl catalogue build; like
# the entries above, its name does not match the standard `target/` rule.
/.catalog-musl-target/
/.android-tmp.*/
/.deploy-tmp/
/release/
/squashfs-root/
*.profraw
*.profdata
perf.data
perf.data.old
flamegraph.svg

# Scratch analysis runs and test scratch directories. These hold multi-gigabyte
# extracts and built wasm bundles, so they must never be staged.
/tmp/
/.test-tmp/
/client/.test-tmp/
/.orphan-sql-report

# Keep generated Cargo lockfiles local.
**/Cargo.lock

# Local design and planning documents are excluded from the public repository.
/docs/
/.agents/
/BACKEND_REFACTOR_HANDOFF.md
/DATABASE_REFACTOR_HANDOFF.md
/.restore_split_schemas.py

