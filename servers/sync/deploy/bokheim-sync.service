[Unit]
Description=Bokheim synchronization server
Wants=network-online.target
After=network-online.target postgresql.service
RequiresMountsFor=/var/lib/bokheim/assets
AssertPathIsMountPoint=/var/lib/bokheim/assets
StartLimitIntervalSec=2min
StartLimitBurst=5

[Service]
Type=exec
User=bokheim
Group=bokheim
WorkingDirectory=/var/lib/bokheim
ExecStart=/usr/local/bin/sync-server
Environment=SYNC_SERVER_SOCKET=/run/bokheim/sync.sock
Environment=RUST_LOG=info,sync_performance=debug
Environment="BOKHEIM_EMAIL_FROM=Bokheim <accounts@mail.bokheim.se>"
Environment=BOKHEIM_TEST_USER_EMAIL=test@bokheim.se
Environment=BOKHEIM_ADMIN_EMAIL=admin@bokheim.se
Environment=BOKHEIM_ASSETS_DIR=/var/lib/bokheim/assets
LoadCredential=database_url:/etc/bokheim/database-url
LoadCredential=account_token_key:/etc/bokheim/account-token-key
LoadCredential=admin_password:/etc/bokheim/admin-password
LoadCredential=resend_api_key:/etc/bokheim/resend-api-key
LoadCredential=test_user_password:/etc/bokheim/test-user-password

RuntimeDirectory=bokheim
RuntimeDirectoryMode=0750
StateDirectory=bokheim
StateDirectoryMode=0750
UMask=0007

Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s
KillSignal=SIGTERM
OOMPolicy=kill
MemoryHigh=1536M
MemoryMax=2G
TasksMax=256
LimitNOFILE=65536

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
