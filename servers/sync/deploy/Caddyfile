{
	email {$ACME_EMAIL}
	grace_period 35s
	servers {
		timeouts {
			read_header 10s
			read_body 2h
			write 2h
			idle 2m
		}
		max_header_size 64KB
	}
}

# Shared by the API host and browser proxy. The wire media type is outside
# Caddy's default compression matcher; images and audiobook ranges stay separate.
(bokheim_protobuf_compression) {
	encode zstd gzip {
		match {
			header Content-Type application/vnd.bokheim+protobuf*
		}
	}
}

{$BOKHEIM_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	import bokheim_protobuf_compression
	reverse_proxy unix//run/bokheim/sync.sock
}

{$BOKHEIM_APP_DOMAIN:app.bokheim.se} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	@reader not path /google_cloud_login.html
	header @reader {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
	}
	@google_login path /google_cloud_login.html
	header @google_login {
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Embedder-Policy "unsafe-none"
		Referrer-Policy "no-referrer"
	}

	# Compress the GPUI JavaScript and WebAssembly bundle in transit.
	encode zstd gzip

	# The HTML shell always revalidates, while each build's versioned bundle is
	# immutable. A new deployment changes the bundle URL, so cached JavaScript
	# can never be paired with WebAssembly from another build.
	@immutable path /pkg/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@revalidate not {
		path /api/* /pkg/*
	}
	header @revalidate Cache-Control "no-cache"

	# Credential associations must be JSON, never the SPA fallback or a redirect.
	handle /.well-known/assetlinks.json {
		root * /usr/local/share/bokheim-web/current
		header Content-Type application/json
		file_server {
			precompressed br gzip
		}
	}

	handle /api/* {
		import bokheim_protobuf_compression
		reverse_proxy unix//run/bokheim/sync.sock
	}

	handle {
		root * /usr/local/share/bokheim-web/current
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}

{$BOKHEIM_METADATA_DOMAIN:meta.bokheim.se} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@metadata_api path /health /v3/books /v2/audiobooks/audible
	handle @metadata_api {
		import bokheim_protobuf_compression
		reverse_proxy 127.0.0.1:8091
	}

	respond 404
}

{$BOKHEIM_TAXONOMY_DOMAIN:taxonomy.bokheim.se} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Browsers download the taxonomy snapshot at runtime; SQLite compresses well.
	encode zstd gzip

	handle /releases/* {
		root * /srv/bokheim-updates/public/taxonomy
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	respond 404
}

{$BOKHEIM_CATALOG_DOMAIN:catalogs.bokheim.se} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Access-Control-Allow-Origin "*"
		-Server
	}

	# SQLite is excluded by encode's default content-type filter. Match the
	# snapshot path explicitly and compress successful full downloads.
	@catalog_snapshot path /releases/*/catalog.sqlite3
	encode @catalog_snapshot zstd gzip {
		match {
			status 200
		}
	}

	# Snapshots, books and covers are named by release or content hash, so
	# every URL is immutable. Downloads need no account.
	@files path /releases/* /books/* /covers/*
	handle @files {
		root * /srv/bokheim-updates/public/catalog
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			# Publication supplies stronger compression once per release.
			precompressed zstd gzip
		}
	}

	respond 404
}

{$BOKHEIM_UPDATES_DOMAIN:updates.bokheim.se} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Access-Control-Allow-Origin "*"
		-Server
	}
	root * /srv/bokheim-updates/public/updates
	handle /v1/* {
		header Content-Type application/json
		header Cache-Control "no-cache"
		file_server
	}
	handle /releases/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	respond 404
}
