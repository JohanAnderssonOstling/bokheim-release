[Unit]
Description=Bokheim taxonomy server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=2min
StartLimitBurst=5

[Service]
Type=exec
DynamicUser=true
ExecStart=/usr/local/bin/taxonomy-server
Environment=BOKHEIM_TAXONOMY_BIND=127.0.0.1:8093
Environment=BOKHEIM_TAXONOMY_DATABASE=/usr/local/share/bokheim-taxonomy/unified-taxonomy-v2.sqlite3
Environment=RUST_LOG=info
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s
KillSignal=SIGTERM
OOMPolicy=kill
MemoryHigh=768M
MemoryMax=1G
TasksMax=64
LimitNOFILE=4096

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0022

[Install]
WantedBy=multi-user.target
